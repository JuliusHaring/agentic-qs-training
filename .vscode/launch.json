{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "00 - Mock-System",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["mock_system:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "console": "integratedTerminal"
    },
    {
      "name": "00 - MLflow Server",
      "type": "debugpy",
      "request": "launch",
      "module": "mlflow",
      "args": ["server", "--host", "127.0.0.1", "--port", "5000"],
      "console": "integratedTerminal"
    },
    {
      "name": "01 - Aufgabe: Basaler Agent",
      "type": "debugpy",
      "request": "launch",
